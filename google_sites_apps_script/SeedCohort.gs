ble\":[],\"useCaseCaption\":\"\",\"useCaseImage\":\"\"}","","","{}","","2026-11-12T03:22:42.694Z"],["SUB-B09-2","PRJ-B09",2,"Locked","{\"architecturePoints\":[],\"architectureCaption\":\"\",\"architectureImage\":\"\",\"dataDesignPoints\":[],\"dataDesignCaption\":\"\",\"dataDesignImage\":\"\",\"algorithmDesignPoints\":[],\"algorithmDesignCaption\":\"\",\"algorithmDesignImage\":\"\",\"securityDesignPoints\":[]}","","","{}","","2026-11-12T03:22:42.694Z"],["SUB-B09-3","PRJ-B09",3,"Locked","{\"implementation\":\"\",\"modules\":\"\",\"repo\":\"\",\"challenges\":\"\"}","","","{}","","2026-11-12T03:22:42.694Z"],["SUB-B09-4","PRJ-B09",4,"Locked","{\"testing\":\"\",\"test_results\":\"\",\"metrics\":\"\",\"evaluation\":\"\"}","","","{}","","2026-11-12T03:22:42.694Z"]]};

  const lock = LockService.getScriptLock();
  lock.waitLock(25000);
  try {
    const summary = {};
    Object.keys(data).forEach(function(sheetName) {
      const sheet = resolveSheet(sheetName, true);
      const rows = data[sheetName];
      if (!sheet || !rows || !rows.length) return;

      const lastRow = sheet.getLastRow();
      if (lastRow > 1 && !overwriteExisting) {
        summary[sheetName] = "Skipped (" + (lastRow - 1) + " rows exist)";
        return;
      }

      if (lastRow > 1 && overwriteExisting) {
        sheet.getRange(2, 1, lastRow - 1, sheet.getLastColumn()).clearContent();
      }

      sheet.getRange(2, 1, rows.length, rows[0].length).setValues(rows);
      summary[sheetName] = rows.length + " rows written";
    });

    return {
      success: true,
      summary: summary,
      spreadsheetUrl: db.getUrl(),
      message: "Google Sheets database populated with 31 teams and 119 students across 6 themes!"
    };
  } finally {
    lock.releaseLock();
  }
}

